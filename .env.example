# Copy to .env and replace both secrets before docker compose up.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# Optional separate HTTPS origin for payOS callbacks; defaults to PUBLIC_BASE_URL.
WEBHOOK_BASE_URL=
# For HTTPS behind a reverse proxy: list only the actual proxy IP addresses.
TRUSTED_PROXIES=
# Only roomie.io.vn can index; set false for staging or an emergency noindex.
SEO_ALLOW_INDEXING=true

# Registration email OTP (mandatory in Production). Use a verified sender/mailbox.
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Roomie
SMTP_HOST=
SMTP_PORT=587
# StartTls for 587, SslOnConnect for 465. Unencrypted SMTP is rejected in Production.
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional Zalo gateway (compose.zalo.yaml). Generate distinct values; see docs/zalo-setup.md.
ZALO_GATEWAY_TOKEN=
ZALO_SESSION_KEY=
