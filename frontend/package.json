    "test:analytics": "node scripts/test-analytics-tracker.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:dates": "node scripts/test-monitoring-dates.mjs",
    "test:http": "node scripts/test-http-client.mjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/icons": "^6.0.0",
    "@tanstack/react-query": "^5.81.5",
    "antd": "^5.26.5",
    "dayjs": "^1.11.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
