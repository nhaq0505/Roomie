{
  "name": "phong-tro-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "i18n:build": "node scripts/build-i18n.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
